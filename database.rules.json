{
  "rules": {
    "devices": {
      ".read": "auth != null",
      ".write": false
    },
    "alerts": {
      ".read": "auth != null",
      ".write": false,
      ".indexOn": ["ts"],
      "$id": {
        "acknowledged": {
          ".write": "auth != null",
          ".validate": "newData.isBoolean()"
        }
      }
    }
  }
}
